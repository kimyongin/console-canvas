{
  "name": "console-canvas",
  "version": "0.31.0",
  "private": true,
  "description": "Embedded Chromium console UI editor with MCP control",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "build": "python3 scripts/build.py",
    "test": "node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "check:web": "node scripts/check.mjs --web",
    "check:all": "node scripts/check.mjs --all",
    "test:browser": "electron tests/browser-runner.cjs",
    "test:desktop": "node scripts/check-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test:desktop:offscreen": "node scripts/check-desktop.mjs --offscreen"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  }
}
