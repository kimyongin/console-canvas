{
  "name": "console-canvas",
  "version": "0.13.0",
  "private": true,
  "description": "Embedded Chromium console UI editor with MCP control",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
