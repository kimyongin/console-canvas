    {
      "name": "apply_code_patches",
      "description": "Directly apply validated HTML/CSS patches to the COPY as one undo step. Use register_ai_candidate instead when asked for alternatives. Does not edit the original site. Resource patches embed observed HTTP(S) image/font references as bounded inert data; no network request is made by MCP.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "editor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "patches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "style",
                    "text",
                    "attributes",
                    "insert",
                    "remove",
                    "reparent",
                    "stylesheet",
                    "resource"
                  ]
                },
                "element_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "properties": {
                  "type": "object"
                },
                "text": {
                  "type": "string",
                  "maxLength": 20000
                },
                "attributes": {
                  "type": "object"
                },
                "html": {
                  "type": "string",
                  "maxLength": 100000
                },
                "parent_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "before_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "css": {
                  "type": "string",
                  "maxLength": 50000
                },
                "resource_url": {
                  "type": "string",
                  "maxLength": 8192
                },
                "data": {
                  "type": "string",
                  "maxLength": 1500000
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "editor_id",
          "expected_revision",
          "operation_id",
          "patches"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ]
