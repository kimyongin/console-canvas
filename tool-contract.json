            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "editor_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_comments",
      "description": "Read component comments with element IDs, original locators and deleted-target status.",
