        "type": "object",
        "properties": {
          "editor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "element_id": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
