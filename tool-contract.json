        "type": "object",
        "properties": {
          "editor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "full_context": {
            "type": "boolean"
          }
        },
        "required": [
          "editor_id",
          "request_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "create_ai_request",
      "description": "Freeze current work for 1–12 alternatives without changing current canvas, undo or active snapshot. Agent returns candidates; user chooses.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "editor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "prompt": {
            "type": "string",
            "maxLength": 8000
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "basis_request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "basis_candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "editor_id",
          "expected_revision",
          "operation_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "register_ai_candidate",
      "description": "Validate and save a named alternative derived from the request baseline. Never auto-applies. Patch types: style(properties), text(leaf text), attributes, insert(html with new a-prefixed data-uic-id), remove, reparent(parent_id/before_id), stylesheet(css). No scripts or external CSS URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "editor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          },
          "patches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "style",
                    "text",
                    "attributes",
                    "insert",
                    "remove",
                    "reparent",
                    "stylesheet"
                  ]
                },
                "element_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "properties": {
                  "type": "object"
                },
                "text": {
                  "type": "string",
                  "maxLength": 20000
                },
                "attributes": {
                  "type": "object"
                },
                "html": {
                  "type": "string",
                  "maxLength": 100000
                },
                "parent_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "before_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "css": {
                  "type": "string",
                  "maxLength": 50000
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "editor_id",
          "expected_revision",
          "operation_id",
          "request_id",
          "name",
          "patches"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
