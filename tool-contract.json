    {
      "name": "apply_edits",
      "description": "Atomically apply moves, deletions and component comment edits as ONE undo step. Move mode absolute sets offsets from capture; relative adds to current offsets. Empty comment text removes it. Does not edit source code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "editor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Unique idempotency key. Retry an uncertain call with the SAME key and identical arguments."
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": {
              "$limit": "operations"
            },
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "move"
                    },
                    "element_id": {
                      "type": "string"
                    },
                    "dx": {
                      "type": "number",
                      "minimum": {
                        "$limit": "-x"
                      },
                      "maximum": {
                        "$limit": "x"
                      }
                    },
                    "dy": {
                      "type": "number",
                      "minimum": {
                        "$limit": "-y"
                      },
                      "maximum": {
                        "$limit": "y"
                      }
                    },
                    "mode": {
                      "enum": [
                        "absolute",
                        "relative"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "element_id",
                    "dx",
                    "dy",
                    "mode"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "point_comment"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": {
                        "$limit": "x"
                      }
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": {
                        "$limit": "y"
                      }
                    },
                    "text": {
                      "type": "string",
                      "maxLength": {
                        "$limit": "comment"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "delete"
                    },
                    "element_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "element_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "comment"
                    },
                    "element_id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": {
                        "$limit": "comment"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "element_id",
                    "text"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "editor_id",
          "expected_revision",
          "operation_id",
          "operations"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "undo",
