    {
      "name": "update_ticket",
      "description": "Append work or review record with ticket revision CAS. working needs human implementation instruction; review needs result image+checks; done needs human approval. Goal cannot be overwritten. Same goal fixes return queued; new goals need new tickets. Resolve ticket_ref by persistent ID/display ID or exact name in the allowed project. Do not require an open editor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "editor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "queued",
              "working",
              "review",
              "done",
              "blocked"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "implementation_instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "implementation_image_data_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000000
          },
          "checks": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "review_decision": {
            "type": "string",
            "enum": [
              "approved"
            ]
          },
          "review_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "goal_id": {
            "type": "string",
            "maxLength": 200
          },
          "ticket_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_ticket_revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "expected_ticket_revision",
          "operation_id",
          "status",
          "summary",
          "ticket_ref"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
