{
  "manifest_version": 3,
  "name": "Console Canvas · 화면 복제 편집기",
  "version": "0.7.2",
  "description": "현재 웹 화면을 소스코드 없이 복제하고 요소 이동·삭제와 자유 텍스트 주석을 전달합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "이 화면을 Console Canvas로 가져오기"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "editor.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  }
}
